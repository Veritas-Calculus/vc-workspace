{
  "realm": "vc-workspace-lab",
  "displayName": "VC Workspace identity lab",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "vc-workspace-lab",
      "name": "VC Workspace lab",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${VC_WORKSPACE_LAB_OIDC_CLIENT_SECRET}",
      "redirectUris": [
        "http://127.0.0.1:18081/api/v1/auth/oidc/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:18081"
      ],
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "groups": [
    { "name": "workspace-users" },
    { "name": "engineering" }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@lab.vc-workspace.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Workspace",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${VC_WORKSPACE_LAB_OIDC_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "groups": [
        "/workspace-users",
        "/engineering"
      ]
    }
  ]
}
