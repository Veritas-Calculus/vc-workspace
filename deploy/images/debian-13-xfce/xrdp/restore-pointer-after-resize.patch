+/*****************************************************************************/
+int
+xrdp_wm_prepare_pointer_reset(struct xrdp_wm *self)
+{
+    struct display_control_monitor_layout_data *resize = self->mm->resize_data;
+    const int index = self->screen->pointer;
+    if (resize == NULL || index < 0 ||
+            index >= self->cache->pointer_cache_entries || index >= 32)
+    {
+        return 1;
+    }
+    if (index >= 2 && self->cache->pointer_items[index].stamp == 0)
+    {
+        return 1;
+    }
+    resize->saved_pointer_index = index;
+    resize->saved_pointer = self->cache->pointer_items[index];
+    resize->pointer_reset = 1;
+    return 0;
+}
+
+/*****************************************************************************/
+int
+xrdp_wm_finish_pointer_reset(struct xrdp_wm *self)
+{
+    struct display_control_monitor_layout_data *resize = self->mm->resize_data;
+    if (resize == NULL || !resize->pointer_reset ||
+            self->cache->pointer_cache_entries < 2 ||
+            self->cache->pointer_cache_entries > 32 ||
+            (resize->saved_pointer_index >= 2 &&
+             self->cache->pointer_cache_entries < 3))
+    {
+        return 1;
+    }
+    resize->pointer_reset = 0;
+    if (resize->saved_pointer_index >= 2)
+    {
+        /* A fresh cache entry sends the image before any cached reference. */
+        self->screen->pointer = xrdp_cache_add_pointer(self->cache,
+                                                      &resize->saved_pointer);
+        return 0;
+    }
+    /* The two static images were already resent by load_static_pointers. */
+    self->screen->pointer = resize->saved_pointer_index;
+    self->current_pointer = self->screen->pointer;
+    return xrdp_wm_set_pointer(self, self->screen->pointer);
 }
 
