@@ -0,0 +1,209 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* Exercise production WM/cache functions with a strict client pointer cache. */
+#if defined(HAVE_CONFIG_H)
+#include "config_ac.h"
+#endif
+#include "test_xrdp.h"
+#include "xrdp.h"
+#include <string.h>
+
+static int client_entries[32];
+static unsigned int images;
+static unsigned int references;
+static struct xrdp_pointer_item last_image;
+
+int
+__wrap_libxrdp_send_pointer(struct xrdp_session *session, int index,
+                          char *data, char *mask, int x, int y, int bpp,
+                          int width, int height)
+{
+    (void)session;
+    ck_assert_int_ge(index, 0);
+    ck_assert_int_lt(index, 32);
+    client_entries[index] = 1;
+    ++images;
+    memset(&last_image, 0, sizeof(last_image));
+    last_image.x = x;
+    last_image.y = y;
+    last_image.bpp = bpp;
+    last_image.width = width;
+    last_image.height = height;
+    if (width > 0 && height > 0)
+    {
+        memcpy(last_image.data, data, ((bpp + 7) / 8) * width * height);
+        memcpy(last_image.mask, mask, width * height / 8);
+    }
+    return 0;
+}
+
+int
+__wrap_libxrdp_set_pointer(struct xrdp_session *session, int index)
+{
+    (void)session;
+    ck_assert_int_ge(index, 0);
+    ck_assert_int_lt(index, 32);
+    ck_assert_msg(client_entries[index], "stale cached pointer %d", index);
+    ++references;
+    return 0;
+}
+
+static struct xrdp_wm *
+fixture(void)
+{
+    struct xrdp_wm *wm = g_new0(struct xrdp_wm, 1);
+    wm->screen = g_new0(struct xrdp_bitmap, 1);
+    wm->screen->child_list = list_create();
+    wm->screen->width = 1920;
+    wm->screen->height = 1080;
+    wm->mm = g_new0(struct xrdp_mm, 1);
+    wm->mm->resize_data = g_new0(struct display_control_monitor_layout_data, 1);
+    wm->client_info = g_new0(struct xrdp_client_info, 1);
+    wm->client_info->pointer_cache_entries = 26;
+    wm->cache = xrdp_cache_create(wm, NULL, wm->client_info);
+    memset(client_entries, 0, sizeof(client_entries));
+    images = references = 0;
+    return wm;
+}
+
+static void
+destroy(struct xrdp_wm *wm)
+{
+    xrdp_cache_delete(wm->cache);
+    list_delete(wm->screen->child_list);
+    g_free(wm->screen);
+    g_free(wm->mm->resize_data);
+    g_free(wm->mm);
+    g_free(wm->client_info);
+    g_free(wm);
+}
+
+static void
+seed_static(struct xrdp_wm *wm)
+{
+    struct xrdp_pointer_item *p = g_new0(struct xrdp_pointer_item, 1);
+    xrdp_cache_add_pointer_static(wm->cache, p, 1);
+    xrdp_cache_add_pointer_static(wm->cache, p, 0);
+    g_free(p);
+}
+
+static void
+backend_pointer(struct xrdp_wm *wm, unsigned char pixel)
+{
+    char data[32 * 32 * 4];
+    char mask[32 * 32 / 8];
+    memset(data, pixel, sizeof(data));
+    memset(mask, 0, sizeof(mask));
+    ck_assert_int_eq(xrdp_wm_pointer(wm, data, mask, 4, 5, 32, 32, 32), 0);
+}
+
+START_TEST(dynamic_pointer_survives_reactivation)
+{
+    struct xrdp_wm *wm = fixture();
+    seed_static(wm);
+    backend_pointer(wm, 0x11);
+    backend_pointer(wm, 0x22);
+    ck_assert_int_eq(wm->screen->pointer, 3);
+    for (int n = 0; n < 32; ++n)
+    {
+        ck_assert_int_eq(xrdp_wm_prepare_pointer_reset(wm), 0);
+        memset(client_entries, 0, sizeof(client_entries));
+        ck_assert_int_eq(xrdp_cache_reset(wm->cache, wm->client_info), 0);
+        const unsigned int before = references;
+        wm->current_pointer = 0;
+        /* Movement while the client is deactivated must send no reference. */
+        ck_assert_int_eq(xrdp_wm_mouse_move(wm, 100, 100), 0);
+        ck_assert_int_eq(references, before);
+        /* A cursor changed by the backend during reset must not get lost. */
+        backend_pointer(wm, 0x22 + n);
+        seed_static(wm);
+        const unsigned int image_count = images;
+        ck_assert_int_eq(xrdp_wm_finish_pointer_reset(wm), 0);
+        ck_assert_int_eq(images, image_count + 1);
+        ck_assert_int_eq(wm->screen->pointer, 2);
+        ck_assert_int_eq(last_image.x, 4);
+        ck_assert_int_eq(last_image.y, 5);
+        ck_assert_int_eq(last_image.width, 32);
+        ck_assert_int_eq(last_image.height, 32);
+        ck_assert_int_eq(last_image.bpp, 32);
+        ck_assert_int_eq((unsigned char)last_image.data[0], 0x22 + n);
+        ck_assert_int_eq((unsigned char)last_image.data[4095], 0x22 + n);
+        wm->current_pointer = 0;
+        ck_assert_int_eq(xrdp_wm_mouse_move(wm, 100, 100), 0);
+        ck_assert_int_eq(references, before + 1);
+    }
+    destroy(wm);
+}
+END_TEST
+
+START_TEST(static_pointer_survives_reactivation)
+{
+    for (int index = 0; index < 2; ++index)
+    {
+        struct xrdp_wm *wm = fixture();
+        seed_static(wm);
+        wm->screen->pointer = index;
+        ck_assert_int_eq(xrdp_wm_prepare_pointer_reset(wm), 0);
+        memset(client_entries, 0, sizeof(client_entries));
+        ck_assert_int_eq(xrdp_cache_reset(wm->cache, wm->client_info), 0);
+        seed_static(wm);
+        ck_assert_int_eq(xrdp_wm_finish_pointer_reset(wm), 0);
+        ck_assert_int_eq(wm->screen->pointer, index);
+        ck_assert_int_eq(wm->current_pointer, index);
+        destroy(wm);
+    }
+}
+END_TEST
+
+START_TEST(saved_dynamic_image_is_resent_without_backend_update)
+{
+    struct xrdp_wm *wm = fixture();
+    seed_static(wm);
+    backend_pointer(wm, 0x33);
+    backend_pointer(wm, 0x77);
+    ck_assert_int_eq(wm->screen->pointer, 3);
+    ck_assert_int_eq(xrdp_wm_prepare_pointer_reset(wm), 0);
+    memset(client_entries, 0, sizeof(client_entries));
+    wm->client_info->pointer_cache_entries = 8;
+    ck_assert_int_eq(xrdp_cache_reset(wm->cache, wm->client_info), 0);
+    seed_static(wm);
+    ck_assert_int_eq(xrdp_wm_finish_pointer_reset(wm), 0);
+    ck_assert_int_eq(wm->screen->pointer, 2);
+    ck_assert_int_eq((unsigned char)last_image.data[0], 0x77);
+    ck_assert_int_eq((unsigned char)last_image.data[4095], 0x77);
+    wm->current_pointer = 0;
+    ck_assert_int_eq(xrdp_wm_mouse_move(wm, 100, 100), 0);
+    destroy(wm);
+}
+END_TEST
+
+START_TEST(invalid_indices_and_changed_capacity_rejected)
+{
+    struct xrdp_wm *wm = fixture();
+    const int invalid[] = {-1, 3, 26, 32, 1000};
+    for (unsigned int n = 0; n < sizeof(invalid) / sizeof(invalid[0]); ++n)
+    {
+        wm->screen->pointer = invalid[n];
+        ck_assert_int_eq(xrdp_wm_prepare_pointer_reset(wm), 1);
+    }
+    seed_static(wm);
+    backend_pointer(wm, 0x44);
+    ck_assert_int_eq(xrdp_wm_prepare_pointer_reset(wm), 0);
+    wm->client_info->pointer_cache_entries = 2;
+    ck_assert_int_eq(xrdp_cache_reset(wm->cache, wm->client_info), 0);
+    ck_assert_int_eq(xrdp_wm_finish_pointer_reset(wm), 1);
+    ck_assert_int_eq(wm->mm->resize_data->pointer_reset, 1);
+    destroy(wm);
+}
+END_TEST
+
+Suite *make_suite_pointer_reset(void)
+{
+    Suite *s = suite_create("pointer reactivation");
+    TCase *tc = tcase_create("cache lifecycle");
+    tcase_add_test(tc, dynamic_pointer_survives_reactivation);
+    tcase_add_test(tc, static_pointer_survives_reactivation);
+    tcase_add_test(tc, saved_dynamic_image_is_resent_without_backend_update);
+    tcase_add_test(tc, invalid_indices_and_changed_capacity_rejected);
+    suite_add_tcase(s, tc);
+    return s;
+}
