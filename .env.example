VC_VDI_HTTP_ADDR=127.0.0.1:8080
VC_VDI_DATABASE_URL=postgres://vc_vdi:vc_vdi@127.0.0.1:55434/vc_vdi?sslmode=disable
VC_VDI_PUBLIC_URL=http://127.0.0.1:5173
VC_VDI_SETUP_TOKEN=replace-with-a-random-one-time-token
VC_VDI_INTERNAL_API_TOKEN=replace-with-a-separate-random-service-token
VC_VDI_NATIVE_CALLBACK_URL=vc-vdi://auth/callback

# Optional. Local accounts remain available when OIDC is disabled or unreachable.
VC_VDI_OIDC_NAME=Organization SSO
VC_VDI_OIDC_ISSUER=
VC_VDI_OIDC_CLIENT_ID=
VC_VDI_OIDC_CLIENT_SECRET=
VC_VDI_OIDC_REDIRECT_URL=http://127.0.0.1:5173/api/v1/auth/oidc/callback

# Development-only password file. Production should use a least-privilege API token.
VC_VDI_PVE_ENDPOINT=https://pve.example.com
VC_VDI_PVE_CREDENTIAL_FILE=/absolute/path/to/pve-credential
VC_VDI_PVE_TOKEN_ID=
VC_VDI_PVE_TOKEN_SECRET=
VC_VDI_PVE_MUTATIONS_ENABLED=false

# Optional image builder. It is available only when PVE mutations are enabled.
# Production should use a dedicated least-privilege Packer token.
VC_VDI_IMAGE_BUILDER_ENABLED=true
VC_VDI_PACKER_PATH=packer
VC_VDI_IMAGE_ROOT=deploy/images
VC_VDI_IMAGE_BUILDER_PVE_TOKEN_ID=
VC_VDI_IMAGE_BUILDER_PVE_TOKEN_SECRET=
VC_VDI_IMAGE_BUILDER_PVE_CREDENTIAL_FILE=
VC_VDI_LINUX_AGENT_BINARY=dist/vc-vdi-guest-agent-linux-amd64
VC_VDI_WINDOWS_AGENT_BINARY=dist/vc-vdi-guest-agent-windows-amd64.exe
VC_VDI_CLOUDBASE_INIT_MSI=dist/CloudbaseInitSetup.msi

# MCP defaults to a local stdio child process. Kubernetes uses authenticated
# stateless Streamable HTTP on /mcp instead.
VC_VDI_API_URL=http://127.0.0.1:8080
VC_VDI_MCP_TRANSPORT=stdio
VC_VDI_MCP_HTTP_ADDR=127.0.0.1:8090
# Required only for stdio. Create a dedicated Agent in Web Access Control and
# paste the one-time credential here. HTTP callers send their own credential.
VC_VDI_MCP_ACCESS_TOKEN=replace-with-the-credential-issued-for-this-agent
