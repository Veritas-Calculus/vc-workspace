VC_WORKSPACE_HTTP_ADDR=127.0.0.1:8080
VC_WORKSPACE_DATABASE_URL=postgres://vc_workspace:vc_workspace@127.0.0.1:55434/vc_workspace?sslmode=disable
VC_WORKSPACE_PUBLIC_URL=http://127.0.0.1:5173
VC_WORKSPACE_SETUP_TOKEN=replace-with-a-random-one-time-token
VC_WORKSPACE_INTERNAL_API_TOKEN=replace-with-a-separate-random-service-token
VC_WORKSPACE_NATIVE_CALLBACK_URL=vc-workspace://auth/callback

# Optional. Local accounts remain available when OIDC is disabled or unreachable.
VC_WORKSPACE_OIDC_NAME=Organization SSO
VC_WORKSPACE_OIDC_ISSUER=
VC_WORKSPACE_OIDC_CLIENT_ID=
VC_WORKSPACE_OIDC_CLIENT_SECRET=
VC_WORKSPACE_OIDC_REDIRECT_URL=http://127.0.0.1:5173/api/v1/auth/oidc/callback
# ID-token array claim used to synchronize OIDC groups on every successful login.
VC_WORKSPACE_OIDC_GROUPS_CLAIM=groups

# Experimental Guest OS identity modes are fail-closed until explicitly enabled.
# SSSD OIDC additionally requires a validated provider; Windows Entra RDP requires
# a macOS FreeRDP build with AAD support, which the default build does not enable.
VC_WORKSPACE_EXPERIMENTAL_SSSD_OIDC_ENABLED=false
VC_WORKSPACE_EXPERIMENTAL_WINDOWS_ENTRA_RDP_ENABLED=false

# Development-only password file. Production should use a least-privilege API token.
VC_WORKSPACE_PVE_ENDPOINT=https://pve.example.com
VC_WORKSPACE_PVE_CREDENTIAL_FILE=/absolute/path/to/pve-credential
VC_WORKSPACE_PVE_TOKEN_ID=
VC_WORKSPACE_PVE_TOKEN_SECRET=
VC_WORKSPACE_PVE_MUTATIONS_ENABLED=false

# Optional image builder. It is available only when PVE mutations are enabled.
# Production should use a dedicated least-privilege Packer token.
VC_WORKSPACE_IMAGE_BUILDER_ENABLED=true
VC_WORKSPACE_PACKER_PATH=packer
VC_WORKSPACE_IMAGE_ROOT=deploy/images
VC_WORKSPACE_IMAGE_BUILDER_PVE_TOKEN_ID=
VC_WORKSPACE_IMAGE_BUILDER_PVE_TOKEN_SECRET=
VC_WORKSPACE_IMAGE_BUILDER_PVE_CREDENTIAL_FILE=
VC_WORKSPACE_LINUX_AGENT_BINARY=dist/vc-workspace-guest-agent-linux-amd64
# Same build/architecture as the Linux Guest; defaults beside its binary.
VC_WORKSPACE_LINUX_PAM_MODULE=dist/pam_vcworkspace.so
VC_WORKSPACE_LINUX_NATIVE_PAM_MODULE=dist/pam_vcworkspace_native.so
# Reviewed xrdp.deb and xrdp-package.sha256 from make debian-xrdp-check.
VC_WORKSPACE_LINUX_XRDP_BUNDLE=dist/debian-13-xrdp
# Trusted provisioning network only: installer HTTP carries bootstrap data.
# Set either the exact reachable address OR interface, never both.
VC_WORKSPACE_IMAGE_HTTP_BIND_ADDRESS=
VC_WORKSPACE_IMAGE_HTTP_INTERFACE=
VC_WORKSPACE_IMAGE_HTTP_PORT_RANGE=8840-8847
VC_WORKSPACE_WINDOWS_AGENT_BINARY=dist/vc-workspace-guest-agent-windows-amd64.exe
VC_WORKSPACE_CLOUDBASE_INIT_MSI=dist/CloudbaseInitSetup.msi

# MCP defaults to a local stdio child process. Kubernetes uses authenticated
# stateless Streamable HTTP on /mcp instead.
VC_WORKSPACE_API_URL=http://127.0.0.1:8080
VC_WORKSPACE_MCP_TRANSPORT=stdio
VC_WORKSPACE_MCP_HTTP_ADDR=127.0.0.1:8090
# Required only for stdio. Create a dedicated Agent in Web Access Control and
# paste the one-time credential here. HTTP callers send their own credential.
VC_WORKSPACE_MCP_ACCESS_TOKEN=replace-with-the-credential-issued-for-this-agent

# Optional dedicated Gateway control listener. Keep disabled until all five
# fields and the database upgrade are explicitly configured. Never expose this
# mTLS port through the public API mux. See docs/architecture/session-gateway.md.
# VC_WORKSPACE_GATEWAY_CONTROL_ADDR=0.0.0.0:8444
# VC_WORKSPACE_GATEWAY_CONTROL_TLS_CERT_FILE=/run/secrets/gateway-control/tls.crt
# VC_WORKSPACE_GATEWAY_CONTROL_TLS_KEY_FILE=/run/secrets/gateway-control/tls.key
# VC_WORKSPACE_GATEWAY_CONTROL_CLIENT_CA_FILE=/run/secrets/gateway-control/client-ca.crt
# VC_WORKSPACE_GATEWAY_CONTROL_PEERS_FILE=/run/secrets/gateway-control/peers.json

# Optional mandatory Native routing, separate from starting the TLS listener.
# Requires a registered Gateway above and a gateway-capable native client.
# Current shipped macOS transport is not wired yet: do not enable this on the
# existing deployment until native tunnel and Guest network isolation acceptance.
# Configured routing rejects old clients and Windows; it never falls back direct.
# VC_WORKSPACE_NATIVE_GATEWAY_ID=gw_exampleprimary
# VC_WORKSPACE_NATIVE_GATEWAY_URL=https://gateway.example.com
# VC_WORKSPACE_NATIVE_GATEWAY_ALLOWED_TARGETS=10.31.0.0/24
