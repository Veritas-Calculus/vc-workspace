+- (void)vcwSendEditKey:(UINT32)key action:(SEL)action
+{
+	if (![self vcwCanPerformEdit:action]) return;
+	rdpInput *input = instance->context->input;
+	/* A menu shortcut may arrive after Command was already forwarded as Win.
+	 * Release held modifiers before the guest shortcut, without toggling Caps
+	 * Lock/Num Lock. The next physical event resynchronizes held modifiers. */
+	const DWORD modifiers[] = { NSEventModifierFlagShift, NSEventModifierFlagControl,
+	                            NSEventModifierFlagOption, NSEventModifierFlagCommand };
+	BOOL ready = YES;
+	for (size_t i = 0; i < ARRAYSIZE(modifiers); i++)
+	{
+		const DWORD flag = modifiers[i];
+		if (updateFlagState(input, kbdModFlags & ~flag, kbdModFlags, flag))
+			kbdModFlags &= ~flag;
+		else ready = NO;
+	}
+	if (!ready) return;
+	BOOL sent = freerdp_input_send_keyboard_event_ex(input, TRUE, FALSE, RDP_SCANCODE_LCONTROL);
+	if (sent)
+	{
+		(void)freerdp_input_send_keyboard_event_ex(input, TRUE, FALSE, key);
+		(void)freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, key);
+	}
+	/* Always attempt release, including a failed press/write. */
+	(void)freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, RDP_SCANCODE_LCONTROL);
+}
