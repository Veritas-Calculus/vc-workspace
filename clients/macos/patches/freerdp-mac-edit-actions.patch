+- (BOOL)vcwCanPerformEdit:(SEL)action
+{
+	if (!is_connected || !instance || !instance->context || !instance->context->input)
+		return NO;
+	if (action == @selector(selectAll:)) return YES;
+	if (action == @selector(paste:) && (!mfc || !mfc->clipboard || !context || !context->settings)) return NO;
+	if (action != @selector(copy:) && action != @selector(cut:) && action != @selector(paste:)) return NO;
+	return mfc && mfc->clipboardSync && mfc->cliprdr && instance->context->settings &&
+	       freerdp_settings_get_bool(instance->context->settings, FreeRDP_RedirectClipboard);
+}
+
+- (BOOL)validateUserInterfaceItem:(id<NSValidatedUserInterfaceItem>)item
