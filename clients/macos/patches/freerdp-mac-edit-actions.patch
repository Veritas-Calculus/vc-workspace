+- (void)paste:(id)sender
+{
+	(void)sender;
+	VCWClipboardDelivery *delivery = self->clipboard_delivery;
+	[delivery performIfActive:^{
+		if (![self vcwCanPerformEdit:@selector(paste:)])
+		{ WLog_WARN(TAG, "VCW paste rejected: channel or policy unavailable"); return; }
+		if (![self vcwHasPasteFocus])
+		{ WLog_WARN(TAG, "VCW paste rejected: desktop does not own active focus"); return; }
+		if (![delivery beginPasteVersion:[pasteboard_rd changeCount]
+		                         atTime:NSProcessInfo.processInfo.systemUptime]) return;
+		[self vcwAdvancePaste];
+	}];
+}
+
+- (void)vcwPasteRejected
+{
+	NSBeep();
+}
+
+- (BOOL)vcwHasPasteFocus
+{
+	return self.window.isKeyWindow && self.window.firstResponder == self && NSApp.isActive;
 }
 
+- (void)vcwAdvancePaste
+{
+	VCWClipboardDelivery *delivery = self->clipboard_delivery;
+	[delivery performIfActive:^{
+		if (![delivery hasPendingPaste]) return;
+		if (![self vcwCanPerformEdit:@selector(paste:)] || ![self vcwHasPasteFocus])
+		{ WLog_WARN(TAG, "VCW paste cancelled: readiness or focus changed"); [delivery cancelPaste]; return; }
+		[self vcwReadPasteboard];
+		const VCWPasteDecision decision = [delivery takePasteForVersion:[pasteboard_rd changeCount]
+		    published:pasteboard_changecount atTime:NSProcessInfo.processInfo.systemUptime];
+		if (decision == VCWPasteRejected)
+		{ WLog_WARN(TAG, "VCW paste cancelled: version changed, confirmation rejected or timed out"); [self vcwPasteRejected]; return; }
+		if (decision != VCWPasteReady) return;
+		/* Empty/unsupported snapshots must never invoke a paste against old
+		 * guest contents. This is the exact confirmed outbound buffer. */
+		const UINT32 format = ClipboardGetFormatId(mfc->clipboard, "text/plain");
+		UINT32 size = 0;
+		void *data = format ? ClipboardGetData(mfc->clipboard, format, &size) : NULL;
+		const BOOL hasText = data && size > 1;
+		free(data);
+		if (hasText) [self vcwSendEditKey:RDP_SCANCODE_KEY_V action:@selector(paste:)];
+		else WLog_WARN(TAG, "VCW paste rejected: confirmed snapshot has no supported text");
+	}];
+}
