 - (void)onPasteboardTimerFired:(NSTimer *)timer
 {
+	/* The timer retains its channel's cancellation gate. Closing the channel
+	 * excludes this entire read/send operation before freeing its context. */
+	VCWClipboardDelivery *delivery = timer.userInfo;
+	[delivery performIfActive:^{
+		[self vcwReadPasteboard];
+		if ([delivery hasPendingPaste]) [self vcwAdvancePaste];
+	}];
+}
+
+- (void)vcwSetClipboardDelivery:(id)delivery
+{
+	[self->pasteboard_timer invalidate];
+	self->pasteboard_timer = nil;
+	[self->clipboard_delivery release];
+	self->clipboard_delivery = [delivery retain];
+	[self vcwResumeClipboard];
+}
+
+- (void)vcwClearClipboardDelivery:(id)delivery
+{
+	/* A queued close for the previous channel cannot cancel its successor. */
+	if (self->clipboard_delivery != delivery) return;
+	[self->pasteboard_timer invalidate];
+	self->pasteboard_timer = nil;
+	[self->clipboard_delivery release];
+	self->clipboard_delivery = nil;
+}
+
+- (void)vcwResumeClipboard
+{
+	[self->clipboard_delivery performIfActive:^{
+		if (!self.is_connected || self->pasteboard_timer) return;
+		self->pasteboard_timer = [NSTimer scheduledTimerWithTimeInterval:0.5
+		    target:self selector:@selector(onPasteboardTimerFired:)
+		    userInfo:self->clipboard_delivery repeats:YES];
+	}];
+}
+
